new file mode 100644
index 0000000..4f98640
--- /dev/null
+++ b/sherpa-onnx/csrc/private-ort-env.h
@@ -0,0 +1,13 @@
+#pragma once
+#include "onnxruntime_cxx_api.h"
+namespace sherpa_onnx {
+// Keep ONNX diagnostics out of system logging, including malformed input errors.
+class PrivateOrtEnv : public Ort::Env {
+ public:
+  PrivateOrtEnv(OrtLoggingLevel = ORT_LOGGING_LEVEL_FATAL, const char* = nullptr)
+      : Ort::Env(ORT_LOGGING_LEVEL_FATAL, "LocalVoiceTranslator",
+          [](void*, OrtLoggingLevel, const char*, const char*, const char*, const char*) {}, nullptr) {
+    DisableTelemetryEvents();
+  }
+};
+}
